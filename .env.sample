# LLM PROVIDERS
# Providers are configured in providers.json (copy providers.sample.json).
# The order to try them in, as a JSON list of provider names from providers.json:
CHAT_PROVIDER_PRIORITY='["ollama_cloud", "ollama_local"]'
# The only provider used by the tests that call an LLM. If it fails, the tests fail.
TEST_CHAT_PROVIDER="ollama_cloud"
# API keys, read from the variable named in each provider's api_key_env.
OLLAMA_CLOUD_API_KEY=""
#PROVIDER_API_KEY=""

# MCP SERVER
MCP_SERVER_URL="http://127.0.0.1:8080/mcp"

# BOTS INTERFACES
TELEGRAM_TOKEN=""
DISCORD_TOKEN=""
TELEGRAM_MESSAGE_LIMIT=4096
DISCORD_MESSAGE_LIMIT=2000

# LANGFUSE
APP_NAME="GarysEconomics_bot"
# Records latency, token usage and which providers and models are used.
# Off by default. Langfuse library reads any value other than false as true.
LANGFUSE_TRACING_ENABLED=false
# Sends the questions and answers to Langfuse. Off by default.
LANGFUSE_MESSAGE_TRACING_ENABLED=false
# Get the keys and url from your langfuse server. Langfuse tracing won't work without them.
LANGFUSE_PUBLIC_KEY=""
LANGFUSE_SECRET_KEY=""
LANGFUSE_BASE_URL="https://cloud.langfuse.com"
# Labels the traces so they can be filtered in Langfuse by server.
# Example: "production" or "testing".
LANGFUSE_TRACING_ENVIRONMENT=development
# Replaces LANGFUSE_TRACING_ENVIRONMENT while running pytest.
LANGFUSE_TEST_TRACING_ENVIRONMENT=automated_tests
# Names this app in the traces (service.name). OTEL stands for OpenTelemetry,
# the open standard for traces that the Langfuse SDK is built on.
OTEL_SERVICE_NAME=garys-economics-chatbot
